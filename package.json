{
  "name": "@agentwatch/bridge",
  "version": "0.1.0",
  "description": "Telemetry bridge for Claude Code and Codex that attributes native OTel token costs to Git branches, Jira tickets and features.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentwatch": "./dist/cli.js"
  },
  "exports": {
    "./events": "./dist/events/product-event.js",
    "./llm-call": "./dist/events/llm-call.js",
    "./otlp": "./dist/otlp/normalize.js",
    "./aggregate-turn": "./dist/turns/aggregate-usage.js",
    "./turn-summary": "./dist/turns/turn-summary.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "node example/server.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentwatch/bridge.git"
  },
  "keywords": [
    "telemetry",
    "opentelemetry",
    "claude-code",
    "codex",
    "ai-coding-agents",
    "ai-cost",
    "cost-attribution",
    "feature-cost",
    "observability",
    "hooks"
  ],
  "dependencies": {
    "smol-toml": "^1.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
